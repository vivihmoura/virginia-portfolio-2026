---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Virginia Moura — About" active="about" theme="yellow">
  <section class="about-hero">
    <div class="about-content">
      <h1 class="about-title reveal">Hello,<br>I'm Virginia.</h1>

      <div class="about-body">
        <div class="about-col reveal">
          <p>I'm a freelance designer and illustrator from Rio, based in Greater Philly. Brooklyn was my home for six vibrant years, and its influence still resonates in my work through frequent visits.</p>
          <p>My career took me through agencies and product companies in Brazil and the U.S., primarily focused on digital design. I've collaborated with brands including Google, Chase, Revlon, Samsung, American Express, and others during my time at agencies such as <a href="https://www.hugeinc.com/" target="_blank" rel="noopener">Huge</a>.</p>
        </div>
        <div class="about-col reveal">
          <p>As an illustrator represented by <a href="https://thebrightagency.com/us" target="_blank" rel="noopener">The Bright Agency</a>, my practice spans editorial, publishing, and brand illustration. I focus on clear, inviting stories with a warm, modern feel. Clients include HarperCollins, Scholastic, Virgin Atlantic, and others.</p>
          <p>Say hi at <a href="mailto:hi@virginiamoura.com?subject=Hi%20Virginia">hi@virginiamoura.com</a></p>
        </div>
      </div>
    </div>

    <div class="about-portrait-bleed reveal">
      <img src="/images/about/about-portrait-desktop.avif" alt="Portrait of Virginia Moura">
    </div>

    <div class="about-portrait-frame reveal">
      <img src="/images/about/about-portrait-mobile.avif" alt="Portrait of Virginia Moura">
    </div>
  </section>
</BaseLayout>
