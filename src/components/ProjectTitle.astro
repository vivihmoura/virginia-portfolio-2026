---
const { title, titleLines, wrapCh } = Astro.props;
---
<h1 class="project-title" style={wrapCh ? `max-width:${wrapCh}ch` : undefined}>{titleLines
  ? titleLines.map((line, i) => (
      <>
        {i > 0 && <br />}
        <span class="title-line">{line}{i === titleLines.length - 1 && "."}</span>
      </>
    ))
  : `${title}.`}</h1>
