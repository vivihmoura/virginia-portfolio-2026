---
import Header from '../components/Header.astro';

const { title, active, theme = "light" } = Astro.props;
---

<html lang="pt-BR" data-theme={theme}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="stylesheet" href="https://use.typekit.net/gsd2bbc.css">
<style is:global>
  :root{
    --bg:#ffffff;
    --ink:#1a1a18;
    --muted:#8a877f;
    --line:#e2ddd3;
    --body:"neue-haas-grotesk-text",sans-serif;
    --display:"neue-haas-grotesk-display",sans-serif;
    --pad:clamp(1.5rem,3vw,2.5rem);
    --small:1.3rem;
    --large:clamp(3.2rem,7.5vw,6.5rem);
    --block-gap:clamp(2rem,5vw,4rem);
    --title-gap:clamp(1.5rem,4vw,2.5rem);
    --header-gap:clamp(7.5rem,22vh,14rem);
    --project-block-gap:clamp(2.5rem,6vw,5rem);
    --project-text-gap:clamp(3.5rem,8vw,6.5rem);
  }
  :root[data-theme="dark"]{
    --bg:#000000;
    --ink:#ffffff;
    --line:#333333;
  }
  :root[data-theme="yellow"]{
    --bg:rgb(252,198,84);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);color:var(--ink);
    font-family:var(--body);font-weight:400;font-size:var(--small);
    line-height:1.4;-webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}

  header{
    display:flex;align-items:center;justify-content:space-between;
    padding:1.6rem var(--pad);
    background:var(--bg);
  }
  nav{display:flex;align-items:center;gap:3rem}
  header a{color:var(--ink);transition:opacity .25s ease}
  header a:hover{opacity:.6}
  header a.active{opacity:.4}
  .brand{font-weight:400}

  .menu-toggle{
    display:none;
    flex-direction:column;justify-content:center;gap:5px;
    width:24px;height:24px;padding:0;
    background:none;border:none;cursor:pointer;
  }
  .menu-toggle span{
    display:block;width:100%;height:2px;background:var(--ink);
    transition:transform .3s ease,opacity .3s ease;
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .menu-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .menu-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

  .hero{
    padding:var(--header-gap) var(--pad) var(--title-gap);
  }
  .hero h1,
  .project-title,
  .about-title{
    font-family:var(--display);font-weight:700;
    font-size:var(--large);
    line-height:.98;letter-spacing:-.015em;
    text-wrap:balance;
  }
  .hero h1{max-width:100%}
  .title-line{display:inline-block;white-space:nowrap}

  .work{padding:0 var(--pad) clamp(4rem,10vh,7rem)}
  .grid{
    display:grid;grid-template-columns:repeat(2,1fr);
    column-gap:var(--pad);
    row-gap:calc(var(--pad) * 2);
  }
  .item{display:block}

  .thumb{
    position:relative;overflow:hidden;border-radius:2px;
    aspect-ratio:4/3;background:var(--ph,#e8e3d8);
  }
  .thumb picture{display:block;width:100%;height:100%}
  .thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .thumb-video video{width:100%;height:100%;object-fit:cover;display:none}

  .thumb-hover-video video{width:100%;height:100%;object-fit:cover;display:block}
  .thumb-hover-video picture{display:none}

  .name{margin-top:.8rem}

  .reveal{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  .project-title{
    padding:var(--header-gap) var(--pad) var(--title-gap);
    max-width:45%;
  }

  .project{padding:0 var(--pad) var(--header-gap)}
  .project-blocks{display:flex;flex-direction:column;gap:var(--project-block-gap)}

  .block-image img{width:100%;height:auto;display:block}
  .block-video video{width:100%;height:auto;display:block}

  .block-images-2{display:flex;gap:var(--block-gap)}
  .block-images-2 img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;flex:1;min-width:0}

  .block-videos-2{display:flex;gap:var(--block-gap)}
  .videos-2-item{flex:1;min-width:0;display:flex;justify-content:center}
  .videos-2-item video{max-width:100%;height:auto;display:block}

  .rotating-svg-wrap{position:relative;width:100%}
  .rotating-svg-bg{width:100%;height:auto;display:block}
  .rotating-svg-center{
    position:absolute;inset:0;
    display:flex;align-items:center;justify-content:center;
  }
  .rotating-svg{
    width:41.07%;aspect-ratio:1/1;
    display:block;
    transform-origin:center;
    animation:rotate 19.22s linear infinite;
  }
  @keyframes rotate{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
  }
  @media(prefers-reduced-motion:reduce){
    .rotating-svg{animation:none}
  }

  .block-text{
    display:grid;grid-template-columns:1fr 2fr;gap:var(--block-gap);
    margin-top:calc(var(--title-gap) - var(--project-block-gap));
    margin-bottom:var(--project-text-gap);
  }
  .block-meta a,
  .block-text-content a{transition:opacity .25s ease}
  .block-meta a:hover,
  .block-text-content a:hover{opacity:.4}
  .block-text-content{display:flex;justify-content:flex-end}
  .block-text-content p{max-width:65ch}

  .project-nav{
    display:flex;justify-content:space-between;
    padding-top:var(--title-gap);
  }

  .about-hero{
    position:relative;
    display:grid;
    grid-template-columns:1fr auto;
    grid-template-areas:"content portrait";
    column-gap:var(--block-gap);
    align-items:start;
    min-height:85vh;
    padding:var(--header-gap) var(--pad) clamp(4rem,10vh,7rem);
  }
  .about-content{
    grid-area:content;
    display:flex;flex-direction:column;gap:var(--title-gap);
  }
  .about-body{
    display:grid;grid-template-columns:1fr 1fr;gap:var(--block-gap);
  }
  .about-body p{margin-bottom:1em}
  .about-body p:last-child{margin-bottom:0}
  .about-body a{text-decoration:underline}

  .about-portrait-bleed{
    grid-area:portrait;
    align-self:start;
    justify-self:end;
    height:calc(100vh - var(--header-gap));
    max-width:48vw;
    aspect-ratio:3/4;
    overflow:hidden;
    margin-right:calc(var(--pad) * -1);
    margin-bottom:calc(clamp(4rem,10vh,7rem) * -1);
  }
  .about-portrait-bleed img{
    width:100%;height:100%;object-fit:cover;object-position:top;display:block;
  }

  .about-portrait-frame{
    display:none;
    grid-area:frame;
    width:70%;max-width:336px;
    aspect-ratio:1/1;
    margin-inline-end:auto;
  }
  .about-portrait-frame img{width:100%;height:100%;object-fit:contain;display:block}

  @media(max-width:991px){
    .about-hero{
      grid-template-columns:1fr;
      grid-template-areas:
        "frame"
        "content";
      row-gap:calc(var(--title-gap) * 0.65);
      min-height:0;
      padding-top:calc(var(--title-gap) * 3.6);
    }
    .about-title{max-width:100%}
    .about-portrait-bleed{display:none}
    .about-portrait-frame{display:block}
    .about-body{grid-template-columns:1fr}

    .block-image img,
    .block-video video{height:clamp(260px,45vw,560px);object-fit:cover}
    .block-images-2{flex-direction:column}
    .block-videos-2{flex-direction:column}
    .block-text{grid-template-columns:1fr}
    .block-text-content{justify-content:flex-start}
  }

  @media(max-width:1024px){
    :root{--small:1.1rem}
    header{position:sticky;top:0;z-index:20;transition:transform .3s ease;padding:calc(1.6rem * 0.7) var(--pad)}
    header.header-hidden{transform:translateY(-100%)}
    .menu-toggle{display:flex}
    .brand{position:relative;z-index:1}
    body.nav-open{overflow:hidden}
    nav{
      position:fixed;inset:0;
      flex-direction:column;align-items:stretch;gap:0;
      background:var(--bg);
      padding:5rem var(--pad) 1.5rem;
      opacity:0;visibility:hidden;
    }
    nav.open{
      opacity:1;visibility:visible;
      transition:opacity .25s ease,visibility .25s ease;
    }
    nav a{padding:.7rem 0}
    .hero,
    .project-title{
      padding-top:calc(var(--title-gap) * 3.6);
    }
  }
  @media(max-width:768px){
    .thumb-hover-video video{display:none}
    .thumb-hover-video picture{display:block}
  }
  @media(min-width:601px) and (max-width:1024px){
    .thumb{overflow:visible;aspect-ratio:auto;background:none}
    .thumb picture,
    .thumb img,
    .thumb-video video,
    .thumb-hover-video video{
      width:100%;height:auto;object-fit:contain;
    }
  }
  @media(max-width:600px){
    :root{--large:clamp(2.79rem,11.7vw,4.5rem)}
    .hero h1,
    .project-title,
    .about-title{max-width:100%}
    .grid{grid-template-columns:1fr;row-gap:calc(var(--pad) * 2)}
    .thumb{aspect-ratio:4/5}
    .thumb-video picture{display:none}
    .thumb-video video{display:block}
  }
  @media(max-width:414px){
    :root{--large:2.62rem}
  }
  @media(max-width:340px){
    :root{--large:2.51rem}
  }
  @media(min-width:1440px){
    :root{--large:clamp(2.91rem,6.83vw,5.92rem)}
  }
  @media(prefers-reduced-motion:reduce){
    *{transition:none!important}
    .reveal{opacity:1;transform:none}
  }
</style>
</head>
<body>

<Header active={active} />

<slot />

<script>
  const io=new IntersectionObserver((es)=>{
    es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})
  },{threshold:.12});
  document.querySelectorAll('.reveal').forEach((el,i)=>{
    el.style.transitionDelay=(i%2)*80+'ms';io.observe(el);
  });

  document.querySelectorAll('.thumb-hover-video video').forEach(video=>{
    const item=video.closest('.item');
    item.addEventListener('mouseenter',()=>video.play());
    item.addEventListener('mouseleave',()=>{
      video.pause();
      video.currentTime=0;
    });
  });
</script>
</body>
</html>
